# Server-side only. Copy to deploy/testnet/testnet.env and never commit the real file.
POSTGRES_DB=mst_testnet
POSTGRES_USER=mst
POSTGRES_PASSWORD=replace-with-random-url-safe-secret

# Keep the canary frozen until data migration and verification are complete.
MULTISIG_COORDINATION_WRITE_FREEZE=1
MULTISIG_CLASSIC_MANAGED_EXECUTION_ENABLED=false

# Add runtime secrets only when their existing Testnet behavior is being migrated.
# BLOB_READ_WRITE_TOKEN=
# MULTISIG_INTEGRATION_ADMIN_SECRET_HASH=
# MULTISIG_WEBHOOK_MASTER_SECRET=
# CRON_SECRET=
# MULTISIG_CLASSIC_CHANNEL_MASTER_SECRET=

# Add only after a Cloudflare Tunnel is created for api-testnet.multisig.tools.
# CLOUDFLARE_TUNNEL_TOKEN=
