{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/docs",
      "status": 308,
      "headers": { "Location": "https://docs.multisig.tools/stellar" }
    },
    {
      "src": "/docs/(.*)",
      "status": 308,
      "headers": { "Location": "https://docs.multisig.tools/stellar/$1" }
    },
    {
      "src": "/developers",
      "status": 308,
      "headers": { "Location": "https://docs.multisig.tools/stellar/developers" }
    },
    {
      "src": "/developers/(.*)",
      "status": 308,
      "headers": { "Location": "https://docs.multisig.tools/stellar/developers/$1" }
    },
    {
      "src": "/api/(.*)",
      "dest": "${STELLAR_API_ORIGIN}/$1",
      "env": ["STELLAR_API_ORIGIN"],
      "headers": { "x-vercel-enable-rewrite-caching": "0" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "stellar-testnet.multisig.tools" }],
      "headers": { "X-Robots-Tag": "noindex" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://stellar.creit.tech; font-src 'self' data:; connect-src 'self' https://horizon.stellar.org https://horizon-testnet.stellar.org https://rpc.lightsail.network https://soroban-testnet.stellar.org",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
