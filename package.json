{
  "name": "multisig-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/stellar-api",
    "apps/web",
    "packages/stellar-core"
  ],
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "npm run dev -w @multisig-tools/web",
    "build": "npm run typecheck -w @multisig-tools/stellar-core && tsc -p tsconfig.stellar.json && tsc -p tsconfig.api.json && npm run build -w @multisig-tools/web",
    "live:e2e:request": "tsx scripts/liveRequestServiceE2e.ts",
    "preview": "npm run preview -w @multisig-tools/web",
    "clean": "rm -rf dist apps/web/dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test apps/web/src/stellar/*.test.ts apps/stellar-api/stellar/server/*.test.ts apps/stellar-api/stellar/platform/vercel/*.test.ts",
    "integration:credential": "tsx apps/stellar-api/scripts/createIntegrationCredential.ts",
    "integration:admin-secret": "tsx apps/stellar-api/scripts/createIntegrationAdminSecret.ts",
    "db:migrate": "tsx apps/stellar-api/scripts/applyPostgresMigrations.ts",
    "db:backfill": "tsx apps/stellar-api/scripts/backfillPostgresCoordination.ts",
    "db:verify-recovery": "tsx apps/stellar-api/scripts/verifyPostgresRecovery.ts",
    "test:postgres": "tsx --test --test-concurrency=1 apps/stellar-api/stellar/db/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/blob": "^2.8.0",
    "@vercel/firewall": "1.2.5",
    "@vercel/functions": "^3.9.8",
    "@vercel/queue": "^0.6.0",
    "@vitejs/plugin-react": "^5.0.4",
    "buffer": "^6.0.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "qrcode": "1.5.3",
    "standardwebhooks": "^1.1.1",
    "ipaddr.js": "^2.5.0",
    "@creit.tech/stellar-wallets-kit": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "@types/express": "^4.17.21"
  },
  "packageManager": "npm@11.17.0"
}
