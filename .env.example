# Local-only fallback for private Vercel Blob access.
# Vercel deployments use the project-linked Blob store/OIDC and do not need
# this long-lived token checked into configuration.
BLOB_READ_WRITE_TOKEN=""

# Coordination persistence remains Blob until a verified PostgreSQL backfill
# is complete for that deployment. DATABASE_URL is supplied by the connected
# PostgreSQL provider and must never be committed.
DATABASE_URL=""
MULTISIG_COORDINATION_STORAGE="blob"

# Maintenance-only cutover gate. "1" rejects Request/Intent POST/PATCH/PUT
# with 503 while keeping GET/Activity readable for final delta backfill.
MULTISIG_COORDINATION_WRITE_FREEZE="0"

# Deployment-owned Stellar safety boundary. Production deployments must use
# exactly "public" or "testnet". "dual" is reserved for local compatibility.
VITE_STELLAR_DEPLOYMENT_NETWORK="dual"

# SEP-10 home domain. Set this to the canonical domain of each deployment.
# Mainnet: stellar.multisig.tools ; Testnet: stellar-testnet.multisig.tools
STELLAR_HOME_DOMAIN="stellar.multisig.tools"

# Optional Stellar RPC overrides used only when the Human explicitly runs
# Soroban simulation from Review. These endpoints are public configuration,
# not secrets. Mainnet defaults to Lightsail Quasar; Testnet defaults to SDF.
STELLAR_RPC_PUBLIC_URL="https://rpc.lightsail.network/"
STELLAR_RPC_TESTNET_URL="https://soroban-testnet.stellar.org/"

# Optional explicit S3C adapter provenance. Both values for a network must be
# configured together. Unknown C-accounts remain inspect-only/fail-closed.
# These are public contract/account identities, not secrets.
STELLAR_SOROBAN_SIMPLE_ACCOUNT_PUBLIC_CONTRACT=""
STELLAR_SOROBAN_SIMPLE_ACCOUNT_PUBLIC_OWNER=""
STELLAR_SOROBAN_SIMPLE_ACCOUNT_TESTNET_CONTRACT=""
STELLAR_SOROBAN_SIMPLE_ACCOUNT_TESTNET_OWNER=""

# Optional deployment-owned non-signer Integration identities. Generate an entry
# with `npm run integration:credential -- ...`. Store only the generated hash
# and explicit network / Classic source-account / optional external-execution source-account / Soroban contract-method / executor scopes.
# The msi_ API key itself belongs only in the external service secret store.
MULTISIG_INTEGRATION_CREDENTIALS_JSON=""
